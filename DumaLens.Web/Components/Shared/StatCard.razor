<div class="stat-card">
    <div class="stat-value">@Value</div>
    <div class="stat-label">@Label</div>
</div>

@code {
    /// <summary>
    /// Значение метрики (форматированное)
    /// </summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Подпись метрики
    /// </summary>
    [Parameter]
    public string Label { get; set; } = string.Empty;
}