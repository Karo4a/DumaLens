@if (TotalPages > 1)
{
    <nav class="pager" aria-label="Пагинация">
        <button class="page-btn" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)">←</button>
        @foreach (var p in Pages())
        {
            @if (p < 0)
            {
                <span class="page-dots">…</span>
            }
            else
            {
                <button class="page-btn @(p == Page ? "active" : "")" @onclick="() => Go(p)">@p</button>
            }
        }
        <button class="page-btn" disabled="@(Page >= TotalPages)" @onclick="() => Go(Page + 1)">→</button>
        <span class="page-info">стр. @Page из @TotalPages · по @PageSize</span>
    </nav>
}

@code {
    /// <summary>
    /// Текущая страница (с 1)
    /// </summary>
    [Parameter]
    public int Page { get; set; } = 1;

    /// <summary>
    /// Общее число записей
    /// </summary>
    [Parameter]
    public int TotalCount { get; set; }

    /// <summary>
    /// Размер страницы
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 20;

    /// <summary>
    /// Событие смены страницы
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    private int TotalPages => PageSize > 0 ? (int)Math.Ceiling((double)TotalCount / PageSize) : 0;

    private async Task Go(int page)
    {
        if (page >= 1 && page <= TotalPages && page != Page)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private IEnumerable<int> Pages()
    {
        var total = TotalPages;
        var set = new SortedSet<int> { 1, total, Page, Page - 1, Page + 1, Page - 2, Page + 2 };
        var prev = 0;
        foreach (var p in set)
        {
            if (p < 1 || p > total)
            {
                continue;
            }

            if (prev > 0 && p - prev > 1)
            {
                yield return -1;
            }

            yield return p;
            prev = p;
        }
    }
}