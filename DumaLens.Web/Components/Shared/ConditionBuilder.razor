@using System.Globalization

<details class="cond-builder" open>
    <summary>Фракционные условия <span class="cond-count">@Conditions.Count</span> <span class="cond-and">объединены по И</span></summary>
    @if (Conditions.Count > 0)
    {
        <div class="cond-head">
            <span>Фракция</span><span>Результат</span><span>Оператор</span><span>Порог</span><span>База процента</span><span></span>
        </div>
        @for (var i = 0; i < Conditions.Count; i++)
        {
            var idx = i;
            var cond = Conditions[i];
            <div class="cond-row" @key="cond">
                <select class="ctl" @bind="cond.Faction" @bind:after="Notify">
                    @foreach (var f in Factions)
                    {
                        <option value="@f.Code">@f.Title</option>
                    }
                </select>
                <select class="ctl" value="@cond.Result" @onchange="e => SetResult(idx, e.Value?.ToString())">
                    <option value="accept">ЗА</option>
                    <option value="decline">ПРОТИВ</option>
                    <option value="abstain">ВОЗД</option>
                    <option value="none">НЕ ГОЛ</option>
                </select>
                <select class="ctl op" @bind="cond.Operator" @bind:after="Notify">
                    <option value="gte">≥</option>
                    <option value="lte">≤</option>
                </select>
                <div class="slider-wrap">
                    <input type="range" class="slider" min="0" max="100" step="0.1" value="@cond.Threshold.ToString(CultureInfo.InvariantCulture)" style="@SliderStyle(cond.Threshold)" @onchange="e => SetThreshold(idx, e.Value?.ToString())">
                    <span class="slider-val">@PercentLabel(cond.Threshold)</span>
                    <div class="presets">
                        <button type="button" @onclick="() => SetPreset(idx, 50)">50</button>
                        <button type="button" @onclick="() => SetPreset(idx, 66.7)">66,7</button>
                        <button type="button" @onclick="() => SetPreset(idx, 90)">90</button>
                        <button type="button" @onclick="() => SetPreset(idx, 100)">100</button>
                    </div>
                </div>
                <div class="basis">
                    <label><input type="radio" name="basis-@idx" checked="@(cond.Basis == "members")" @onchange='() => SetBasis(idx, "members")'> от состава</label>
                    <label><input type="radio" name="basis-@idx" checked="@(cond.Basis == "voted")" disabled="@(cond.Result == "none")" @onchange='() => SetBasis(idx, "voted")'> от голосовавших</label>
                </div>
                <button type="button" class="cond-del" title="Удалить условие" @onclick="() => Remove(idx)">×</button>
            </div>
        }
    }
    <div class="cond-actions">
        <button type="button" class="btn-ghost" disabled="@(Conditions.Count >= MaxConditions)" title="@(Conditions.Count >= MaxConditions ? $"Достигнут лимит условий ({MaxConditions})" : null)" @onclick="Add">+ Добавить условие</button>
    </div>
</details>

@code {
    /// <summary>
    /// Список условий конструктора (изменяется компонентом)
    /// </summary>
    [Parameter]
    public List<FactionConditionUi> Conditions { get; set; } = [];

    /// <summary>
    /// Справочник фракций для выбора
    /// </summary>
    [Parameter]
    public IReadOnlyList<FactionApiModel> Factions { get; set; } = [];

    /// <summary>
    /// Лимит числа условий — ограничение API (VoteSearchValidationConstants.FactionConditionsMax);
    /// Web не ссылается на Entities, значение продублировано осознанно
    /// </summary>
    public const int MaxConditions = 10;

    /// <summary>
    /// Событие изменения условий (двусторонняя привязка @bind-Conditions)
    /// </summary>
    [Parameter]
    public EventCallback<List<FactionConditionUi>> ConditionsChanged { get; set; }

    private async Task Notify()
    {
        await ConditionsChanged.InvokeAsync(Conditions);
    }

    private async Task Add()
    {
        if (Conditions.Count >= MaxConditions)
        {
            return;
        }

        Conditions.Add(new FactionConditionUi());
        await Notify();
    }

    private async Task Remove(int idx)
    {
        Conditions.RemoveAt(idx);
        await Notify();
    }

    private async Task SetResult(int idx, string? value)
    {
        var c = Conditions[idx];
        c.Result = value ?? "accept";
        if (c.Result == "none")
        {
            c.Basis = "members";
        }

        await Notify();
    }

    private async Task SetThreshold(int idx, string? value)
    {
        if (double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            Conditions[idx].Threshold = v;
        }

        await Notify();
    }

    private async Task SetPreset(int idx, double value)
    {
        Conditions[idx].Threshold = value;
        await Notify();
    }

    private async Task SetBasis(int idx, string value)
    {
        Conditions[idx].Basis = value;
        await Notify();
    }

    /// <summary>
    /// Заполнение дорожки слайдера до текущего порога (рендерится разметкой, синхронно со значением)
    /// </summary>
    private static string SliderStyle(double threshold)
    {
        var v = threshold.ToString("0.##", CultureInfo.InvariantCulture);
        return $"background: linear-gradient(to right, var(--accent) {v}%, var(--border) {v}%)";
    }

    /// <summary>
    /// Подпись порога единой строкой (один текстовый узел — клиентский JS обновляет его при перетаскивании);
    /// формат совпадает с formatPct в theme.js (запятая, тримминг нуля)
    /// </summary>
    private static string PercentLabel(double threshold)
    {
        return threshold.ToString("0.#", CultureInfo.InvariantCulture).Replace('.', ',') + "%";
    }
}