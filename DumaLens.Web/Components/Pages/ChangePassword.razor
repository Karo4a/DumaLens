@page "/change-password"
@inject IAuthClient AuthClient
@inject IClientTokenStore TokenStore
@inject UserState UserState
@inject NavigationManager Navigation

<PageTitle>Смена пароля — DumaLens</PageTitle>

<ProtectedContent>
    <div class="page-head">
        <h1>Смена пароля</h1>
        <p class="lead">После смены пароля все сессии завершаются — потребуется войти снова.</p>
    </div>

    <div class="auth-card card">
        @if (UserState.PasswordIsTemporary)
        {
            <div class="auth-info">У вас временный пароль. Задайте новый пароль для продолжения работы.</div>
        }
        <form @onsubmit="ChangeAsync" @onsubmit:preventDefault>
            <label class="field">
                <span>Текущий пароль</span>
                <input class="ctl" type="password" @bind="currentPassword" @bind:event="oninput" autocomplete="current-password" />
            </label>
            <label class="field">
                <span>Новый пароль (не менее @NewPasswordMinLength символов)</span>
                <input class="ctl" type="password" @bind="newPassword" @bind:event="oninput" autocomplete="new-password" />
            </label>
            <label class="field">
                <span>Повторите новый пароль</span>
                <input class="ctl" type="password" @bind="confirmPassword" @bind:event="oninput" autocomplete="new-password" />
            </label>
            @if (error != null)
            {
                <div class="auth-error" role="alert">@error</div>
            }
            <button class="btn-primary auth-submit" type="submit" disabled="@loading">@(loading ? "Сохранение…" : "Сменить пароль")</button>
        </form>
    </div>
</ProtectedContent>

@code {
    // UserValidationConstants.PasswordMinLength (Web не ссылается на Entities.ValidationConstants — локальная константа)
    private const int NewPasswordMinLength = 8;

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? error;
    private bool loading;

    private async Task ChangeAsync()
    {
        if (loading)
        {
            return;
        }
        error = null;
        if (newPassword.Length < NewPasswordMinLength)
        {
            error = $"Новый пароль должен быть не менее {NewPasswordMinLength} символов";
            return;
        }
        if (newPassword != confirmPassword)
        {
            error = "Пароли не совпадают";
            return;
        }
        loading = true;
        try
        {
            await AuthClient.ChangePasswordAsync(new ChangePasswordRequestApiModel
            {
                CurrentPassword = currentPassword,
                NewPassword = newPassword,
            });
            await TokenStore.ClearAsync();
            // Полная перезагрузка: цепь сбрасывается, состояние не очищаем вручную —
            // иначе ProtectedContent среагирует редиректом на вход и перебьёт адрес возврата
            Navigation.NavigateTo("/login?message=password-changed", forceLoad: true);
        }
        catch (ApiException exception)
        {
            // Сообщение сервера: неверный текущий пароль, блокировка попыток, истёкшая сессия
            error = ApiErrorText.Describe(exception);
        }
        catch (HttpRequestException)
        {
            error = "API недоступен. Повторите позже.";
        }
        finally
        {
            loading = false;
        }
    }
}