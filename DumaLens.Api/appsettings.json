{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dumalens;Username=postgres;Password=CHANGE_ME"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5100", "https://localhost:5101" ]
  },
  "Auth": {
    "Issuer": "DumaLens.Api",
    "Audience": "DumaLens.Web",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "PasswordIterations": 100000,
    "MaxFailedLoginAttempts": 5,
    "LoginLockoutMinutes": 15,
    "LoginRateLimitPermitLimit": 20,
    "LoginRateLimitWindowSeconds": 60,
    "RefreshReuseGraceSeconds": 30,
    "RefreshTokenRetentionDays": 7,
    "TokenCleanupIntervalHours": 24
  }
}
